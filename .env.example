# AI Publish Engine — Configuration
# Copy this file to .env and fill in your keys

AI_PROVIDER=openrouter

# At least one API key is required
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=

# PostgreSQL connection (optional — falls back to JSON file storage)
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/ai_publish_engine

# Optional: fixed admin auth secret. If left empty, a stable secret is
# generated once and persisted to backend/.secret_key on first run.
SECRET_KEY=

# CORS — comma-separated allowed origins (leave empty for development "*")
CORS_ORIGINS=

# Output & job storage paths
OUTPUT_DIR=outputs
JOB_FILE=jobs/jobs.json

# Per-provider model override (optional)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash-001
# OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
# MISTRAL_MODEL=mistral-small-latest
# OPENAI_MODEL=gpt-4o-mini

# Error tracking (optional). Leave empty to disable entirely (default) —
# get a free-tier DSN from sentry.io if/when you want this.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# Uptime alerting (optional). If set, scripts/uptime_check.sh posts a
# message here (Slack-compatible incoming webhook) whenever /api/health
# stops responding, and again when it recovers. Leave empty to just log
# failures locally instead. See scripts/uptime_check.sh for setup.
UPTIME_ALERT_WEBHOOK=
