<div class="view" id="view-revenue" style="display:none">
  <div class="layout">
    <aside class="sidebar" style="max-width:100%;flex:1">
      <div class="sidebar-card">
        <h3>💰 Revenue Dashboard</h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px;margin-bottom:16px" id="revenueStats">
          <div class="stat-card"><div class="stat-value" id="revTotal">$0</div><div class="stat-label">Total Revenue</div></div>
          <div class="stat-card"><div class="stat-value" id="revBooks">0</div><div class="stat-label">Books Sold</div></div>
          <div class="stat-card"><div class="stat-value" id="revAvg">$0</div><div class="stat-label">Avg Price</div></div>
          <div class="stat-card"><div class="stat-value" id="revPlatforms">0</div><div class="stat-label">Platforms</div></div>
          <div class="stat-card"><div class="stat-value" id="revGoal">$0 / $0</div><div class="stat-label">Monthly Goal</div></div>
        </div>
      </div>
      <div class="sidebar-card">
        <h3>➕ Add Sale</h3>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 80px;gap:8px">
          <select id="revPlatform" class="form-select" style="font-size:12px">
            <option value="Amazon KDP">Amazon KDP</option>
            <option value="Google Play">Google Play</option>
            <option value="Apple Books">Apple Books</option>
            <option value="Kobo">Kobo</option>
            <option value="B&N Press">B&N Press</option>
            <option value="Draft2Digital">Draft2Digital</option>
            <option value="StreetLib">StreetLib</option>
            <option value="Smashwords">Smashwords</option>
            <option value="Lulu">Lulu</option>
            <option value="Publio">Publio</option>
            <option value="Virtualo">Virtualo</option>
            <option value="Legimi">Legimi</option>
            <option value="Woblink">Woblink</option>
            <option value="Ebookpoint">Ebookpoint</option>
            <option value="Direct">Direct</option>
          </select>
          <input id="revBookTitle" class="form-input" placeholder="Book title" style="font-size:12px">
          <input id="revAmount" class="form-input" type="number" step="0.01" placeholder="0.00" style="font-size:12px">
          <button class="btn btn-sm btn-primary" onclick="addRevenueEntry()" style="font-size:11px">Add</button>
        </div>
        <div style="margin-top:8px;display:flex;gap:8px;align-items:center">
          <label style="font-size:11px;color:var(--text-muted)">Monthly Goal:</label>
          <input id="revGoalInput" class="form-input" type="number" step="100" value="1000" style="width:100px;font-size:12px">
          <button class="btn btn-sm btn-secondary" onclick="setRevenueGoal()" style="font-size:10px">Set Goal</button>
          <button class="btn btn-sm btn-secondary" onclick="exportRevenueCSV()" style="font-size:10px;margin-left:auto">📥 Export CSV</button>
          <button class="btn btn-sm btn-error" onclick="clearRevenue()" style="font-size:10px">Clear All</button>
        </div>
      </div>
      <div class="sidebar-card" id="revenueChartCard" style="display:none">
        <h3>📊 Monthly Revenue</h3>
        <div style="height:200px;position:relative;display:flex;align-items:flex-end;gap:4px;padding:20px 0 30px" id="revChart"></div>
      </div>
      <div class="sidebar-card" id="revenueTableCard">
        <h3>📋 Sales History <span id="revCount" style="font-size:11px;color:var(--text-muted);font-weight:400"></span></h3>
        <div style="max-height:400px;overflow-y:auto" id="revTable"></div>
      </div>
    </aside>
  </div>
</div>

<div class="view" id="view-series" style="display:none">
