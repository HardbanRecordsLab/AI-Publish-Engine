          <input class="form-input" id="coachAnswer" placeholder="Type your answer..." style="flex:1">
          <button class="btn btn-primary" onclick="sendCoachAnswer()" style="margin-top:6px;width:100%">Send</button>
        </div>
        <button class="btn btn-accent" onclick="startCoach()" id="coachStartBtn" style="width:100%">Start Interview</button>
      </div>
