<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Publishing Engine</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --bg: #070B14;
  --surface: #0F1320;
  --surface-hover: #151B2E;
  --border: #1C2136;
  --border-hover: #2A3250;
  --text-primary: #E8EDF5;
  --text-secondary: #8892A6;
  --text-muted: #5B657A;
  --accent-1: #6366F1;
  --accent-2: #8B5CF6;
  --accent-3: #A855F7;
  --success: #22C55E;
  --error: #EF4444;
  --warning: #F59E0B;
  --radius: 12px;
  --radius-sm: 8px;
  --radius-xs: 6px;
  --shadow: 0 4px 24px rgba(0,0,0,.4);
  --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  --transition: .2s cubic-bezier(.4,0,.2,1);
}
::selection { background: rgba(99,102,241,.3); color: #fff; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text-primary);
  min-height: 100vh;
  line-height: 1.5;
  background-image: radial-gradient(ellipse 80% 60% at 50% -20%, rgba(99,102,241,.08) 0%, transparent 70%);
}
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border-hover); border-radius: 3px; }

/* Header */
.header {
  position: sticky; top: 0; z-index: 100;
  background: rgba(7,11,20,.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
  padding: 0 24px;
  height: 64px;
  display: flex; align-items: center; justify-content: space-between;
}
.header-logo {
  display: flex; align-items: center; gap: 12px;
  font-size: 18px; font-weight: 700; letter-spacing: -.3px;
}
.header-logo svg { width: 28px; height: 28px; }
.header-logo span { background: linear-gradient(135deg, var(--accent-1), var(--accent-3)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
.header-badge {
  font-size: 11px; font-weight: 600;
  padding: 3px 10px; border-radius: 100px;
  background: rgba(99,102,241,.15); color: var(--accent-1);
  border: 1px solid rgba(99,102,241,.25);
  margin-left: 8px;
}

/* Layout */
.layout { display: flex; max-width: 1440px; margin: 0 auto; padding: 24px; gap: 24px; min-height: calc(100vh - 64px); }

/* Sidebar */
.sidebar {
  width: 340px; flex-shrink: 0;
  display: flex; flex-direction: column; gap: 16px;
}
.sidebar-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px;
  transition: border-color var(--transition);
}
.sidebar-card:hover { border-color: var(--border-hover); }
.sidebar-card h3 {
  font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .8px;
  color: var(--text-muted); margin-bottom: 16px;
  display: flex; align-items: center; gap: 8px;
}
.sidebar-card h3 svg { width: 16px; height: 16px; }

.form-group { margin-bottom: 14px; }
.form-group:last-child { margin-bottom: 0; }
.form-label {
  display: block; font-size: 12px; font-weight: 500;
  color: var(--text-secondary); margin-bottom: 5px;
}
.form-input, .form-textarea, .form-select {
  width: 100%; padding: 9px 12px; font-size: 13px;
  background: var(--bg); border: 1px solid var(--border);
  border-radius: var(--radius-xs); color: var(--text-primary);
  font-family: var(--font); outline: none;
  transition: border-color var(--transition);
}
.form-input:focus, .form-textarea:focus, .form-select:focus { border-color: var(--accent-1); }
.form-textarea { resize: vertical; min-height: 80px; }
.form-select { cursor: pointer; }
.form-select option { background: var(--surface); color: var(--text-primary); }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.form-hint { font-size: 11px; color: var(--text-muted); margin-top: 4px; }

/* Content Type Tabs */
.content-tabs { display: flex; gap: 4px; background: var(--bg); padding: 4px; border-radius: var(--radius-sm); margin-bottom: 16px; }
.content-tab {
  flex: 1; padding: 8px 6px; font-size: 11px; font-weight: 600;
  text-align: center; border: none; background: transparent;
  color: var(--text-muted); border-radius: 6px; cursor: pointer;
  transition: all var(--transition); font-family: var(--font);
  white-space: nowrap;
}
.content-tab:hover { color: var(--text-secondary); background: rgba(255,255,255,.03); }
.content-tab.active { color: var(--text-primary); background: var(--surface); box-shadow: 0 1px 4px rgba(0,0,0,.3); }
.content-tab svg { display: block; margin: 0 auto 3px; width: 18px; height: 18px; }

/* Main Area */
.main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 20px; }

/* Drop Zone */
.drop-zone {
  border: 2px dashed var(--border);
  border-radius: var(--radius);
  padding: 32px; text-align: center;
  cursor: pointer; transition: all var(--transition);
  background: var(--surface);
}
.drop-zone:hover, .drop-zone.dragover { border-color: var(--accent-1); background: rgba(99,102,241,.05); }
.drop-zone-icon { font-size: 32px; margin-bottom: 8px; opacity: .5; }
.drop-zone-text { font-size: 14px; color: var(--text-secondary); }
.drop-zone-hint { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
.drop-zone .file-name { font-size: 13px; font-weight: 600; color: var(--accent-1); margin-top: 8px; }

/* Template Grid */
.template-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 10px;
}
.template-card {
  position: relative;
  border-radius: var(--radius-sm);
  border: 2px solid var(--border);
  padding: 14px; cursor: pointer;
  transition: all var(--transition);
  overflow: hidden;
  background: var(--surface);
}
.template-card:hover { border-color: var(--border-hover); transform: translateY(-1px); }
.template-card.active { border-color: var(--accent-1); box-shadow: 0 0 0 1px var(--accent-1); }
.template-card-preview {
  height: 60px; border-radius: 6px; margin-bottom: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 24px; transition: all var(--transition);
}
.template-card-name { font-size: 12px; font-weight: 600; color: var(--text-primary); }
.template-card-desc { font-size: 10px; color: var(--text-muted); margin-top: 2px; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.template-card-check {
  position: absolute; top: 6px; right: 6px;
  width: 18px; height: 18px; border-radius: 50%;
  background: var(--accent-1); display: none;
  align-items: center; justify-content: center;
}
.template-card.active .template-card-check { display: flex; }
.template-card-check svg { width: 10px; height: 10px; stroke: white; stroke-width: 3; }

/* Output Format Chips */
.format-chips { display: flex; gap: 8px; flex-wrap: wrap; }
.format-chip {
  padding: 6px 14px; font-size: 12px; font-weight: 500;
  border-radius: 100px; border: 1px solid var(--border);
  background: var(--surface); color: var(--text-secondary);
  cursor: pointer; transition: all var(--transition);
  font-family: var(--font);
}
.format-chip:hover { border-color: var(--border-hover); color: var(--text-primary); }
.format-chip.active { border-color: var(--accent-1); background: rgba(99,102,241,.1); color: var(--accent-1); }

/* Action Bar */
.action-bar {
  display: flex; gap: 12px; align-items: center;
  padding: 16px 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}
.action-bar .provider-select {
  padding: 8px 12px; font-size: 13px;
  background: var(--bg); border: 1px solid var(--border);
  border-radius: var(--radius-xs); color: var(--text-primary);
  font-family: var(--font); cursor: pointer; outline: none;
  min-width: 140px;
}
.action-bar .provider-select:focus { border-color: var(--accent-1); }
.action-bar .provider-select option { background: var(--surface); }
.provider-indicator { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 6px; }
.provider-indicator.online { background: var(--success); box-shadow: 0 0 6px rgba(34,197,94,.4); }
.provider-indicator.offline { background: var(--text-muted); }

.btn {
  padding: 9px 20px; font-size: 13px; font-weight: 600;
  border: none; border-radius: var(--radius-xs);
  cursor: pointer; transition: all var(--transition);
  font-family: var(--font); display: inline-flex; align-items: center; gap: 6px;
}
.btn:hover { transform: translateY(-1px); }
.btn:active { transform: translateY(0); }
.btn:disabled { opacity: .4; cursor: not-allowed; transform: none; }
.btn-primary {
  background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
  color: white; box-shadow: 0 2px 12px rgba(99,102,241,.3);
}
.btn-primary:hover:not(:disabled) { box-shadow: 0 4px 20px rgba(99,102,241,.4); }
.btn-accent { background: var(--color-accent, #6366F1); color: #fff; }
.btn-accent:hover:not(:disabled) { opacity: .9; }
.btn-secondary { background: var(--surface-hover); color: var(--text-primary); border: 1px solid var(--border); }
.btn-secondary:hover { background: var(--border-hover); }
.btn-success { background: var(--success); color: white; }
.btn-success:hover { box-shadow: 0 4px 16px rgba(34,197,94,.3); }
.btn-error { background: var(--error); color: white; }
.btn-error:hover { box-shadow: 0 4px 16px rgba(239,68,68,.3); }
.btn-sm { padding: 6px 14px; font-size: 12px; }

/* Progress */
.progress-section { display: none; animation: fadeSlideUp .3s ease; }
.progress-section.visible { display: block; }
.cancel-btn:hover { background: rgba(239,68,68,.1); }
.cancel-btn:active { transform: scale(.97); }
.spa-nav { display:flex; gap:4px; padding:8px 16px; background:var(--surface); border-bottom:1px solid var(--border); position:sticky; top:0; z-index:100; }
.spa-link { padding:6px 16px; border-radius:100px; font-size:13px; font-weight:500; color:var(--text-muted); text-decoration:none; transition:all .15s; }
.spa-link:hover { background:var(--surface-hover); color:var(--text-primary); }
.spa-link.active { background:var(--accent-1); color:#fff; }
.view { display:none; }
.view:first-of-type { display:block; }
.stat-card { background:var(--surface); border:1px solid var(--border); border-radius:8px; padding:12px; text-align:center; }
.stat-value { font-size:24px; font-weight:700; }
.stat-label { font-size:11px; color:var(--text-muted); text-transform:uppercase; letter-spacing:.5px; }
.status-badge { display:inline-block; padding:2px 8px; border-radius:100px; font-size:10px; font-weight:600; text-transform:capitalize; }
.status-done { background:rgba(34,197,94,.15); color:var(--success); }
.status-failed { background:rgba(239,68,68,.15); color:var(--error); }
.status-processing { background:rgba(99,102,241,.15); color:var(--accent-1); }
.status-queued { background:rgba(245,158,11,.15); color:var(--warning); }
.status-cancelled { background:rgba(100,116,139,.15); color:var(--text-muted); }
@keyframes fadeSlideUp { from { opacity:0; transform:translateY(8px) } to { opacity:1; transform:translateY(0) } }
.progress-steps {
  display: grid; grid-template-columns: repeat(9, 1fr); gap: 4px;
  margin-bottom: 14px;
}
.progress-step {
  text-align: center; padding: 6px 2px;
  border-radius: var(--radius-sm);
  background: var(--surface); border: 1px solid var(--border);
  transition: all var(--transition);
  position: relative;
}
.progress-step.done { background: rgba(34,197,94,.1); border-color: rgba(34,197,94,.3); }
.progress-step.current { background: rgba(99,102,241,.1); border-color: var(--accent-1); }
.progress-step.current::after { content:''; position:absolute; bottom:-2px; left:20%; width:60%; height:2px; background:var(--accent-1); border-radius:1px; animation: progressPulse 1.5s ease infinite; }
@keyframes progressPulse { 0%,100% { opacity:1 } 50% { opacity:.3 } }
.progress-step.failed { background: rgba(239,68,68,.1); border-color: rgba(239,68,68,.3); }
.progress-step-icon { font-size: 13px; display: block; margin-bottom: 1px; }
.progress-step-label { font-size: 8px; font-weight: 500; color: var(--text-muted); line-height: 1.1; }
.progress-step.done .progress-step-label { color: var(--success); }
.progress-step.current .progress-step-label { color: var(--accent-1); }
.progress-bar-wrap {
  width: 100%; height: 5px;
  background: var(--border); border-radius: 3px; overflow: hidden;
}
.progress-bar-fill {
  height: 100%; border-radius: 3px;
  background: linear-gradient(90deg, var(--accent-1), var(--accent-3));
  transition: width .4s cubic-bezier(.4,0,.2,1); width: 0%;
}
.progress-stats { display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted); margin-top: 8px; }
.progress-stats .stat { display: flex; align-items: center; gap: 4px; }
.progress-stats .stat-dot { width: 6px; height: 6px; border-radius: 50%; display: inline-block; }
.progress-stats .stat-dot.green { background: var(--success); }
.progress-stats .stat-dot.purple { background: var(--accent-1); }

/* Result Card */
.result-card {
  display: none;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
}
.result-card.visible { display: block; }
.result-title { font-size: 16px; font-weight: 700; margin-bottom: 4px; }
.result-meta { font-size: 12px; color: var(--text-muted); margin-bottom: 16px; }
.result-formats { display: flex; gap: 8px; flex-wrap: wrap; }
.result-format-btn {
  padding: 10px 20px; font-size: 13px; font-weight: 600;
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  background: var(--surface-hover); color: var(--text-primary);
  cursor: pointer; transition: all var(--transition);
  text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--font);
}
.result-format-btn:hover { border-color: var(--accent-1); background: rgba(99,102,241,.1); transform: translateY(-1px); }
.result-format-btn .format-icon { font-size: 18px; }

/* Error Card */
.error-card {
  display: none;
  background: rgba(239,68,68,.08);
  border: 1px solid rgba(239,68,68,.2);
  border-radius: var(--radius);
  padding: 20px;
}
.error-card.visible { display: block; }
.error-title { font-size: 14px; font-weight: 600; color: var(--error); margin-bottom: 4px; }
.error-msg { font-size: 13px; color: var(--text-secondary); margin-bottom: 12px; }

/* Spinner */
.spinner {
  display: inline-block; width: 16px; height: 16px;
  border: 2px solid rgba(255,255,255,.2);
  border-top-color: white; border-radius: 50%;
  animation: spin .6s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* Loading Skeleton */
.skeleton { background: linear-gradient(90deg, var(--surface) 25%, var(--surface-hover) 50%, var(--surface) 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; border-radius: 6px; }
@keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }

/* Empty State */
.empty-state { text-align: center; padding: 48px 24px; }
.empty-state-icon { font-size: 48px; margin-bottom: 12px; opacity: .3; }
.empty-state-text { font-size: 14px; color: var(--text-muted); }

/* Responsive */
@media (max-width: 900px) {
  .layout { flex-direction: column; padding: 16px; }
  .sidebar { width: 100%; }
  .content-tabs { overflow-x: auto; }
  .content-tab { flex: none; padding: 8px 14px; }
  .template-grid { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); }
  .form-row { grid-template-columns: 1fr; }
  .action-bar { flex-wrap: wrap; }
  .progress-steps { grid-template-columns: repeat(4, 1fr); }
}
@media (max-width: 500px) {
  .header { padding: 0 16px; }
  .progress-steps { grid-template-columns: repeat(3, 1fr); }
  .template-grid { grid-template-columns: repeat(2, 1fr); }
}
</style>
</head>
<body>

<header class="header">
  <div class="header-logo">
    <svg viewBox="0 0 28 28" fill="none"><rect x="2" y="2" width="24" height="24" rx="6" fill="url(#lg)"/><path d="M9 14l3 3 7-7" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span>AI Publishing</span><span class="header-badge">v2</span>
  </div>
  <div style="display:flex;align-items:center;gap:12px">
    <a href="/api/guide" target="_blank" style="font-size:12px;color:var(--text-muted);text-decoration:none;padding:4px 10px;border:1px solid var(--border);border-radius:100px;transition:all .2s" onmouseover="this.style.borderColor='var(--accent-1)';this.style.color='var(--accent-1)'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-muted)'">📖 Guide</a>
    <span class="provider-indicator" id="hdrProviderDot" style="margin-right:0"></span>
    <span style="font-size:12px;color:var(--text-muted)" id="hdrProviderName">openrouter</span>
  </div>
</header>

<nav class="spa-nav">
  <a class="spa-link active" href="#home">Generate</a>
  <a class="spa-link" href="#history">History</a>
    <a class="spa-link" href="#admin" onclick="return loadAdminView()">Admin</a>
    <a class="spa-link" href="#marketing">Marketing</a>
    <a class="spa-link" href="#coach">Book Coach</a>
    <a class="spa-link" href="#publish">Publish</a>
    <a class="spa-link" href="#revenue">Revenue</a>
    <a class="spa-link" href="#series">Series</a>
  </nav>

<div class="view" id="view-home">
<div class="layout">

  <aside class="sidebar">
    <div class="sidebar-card">
      <h3><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><path d="M8 4v4l2 2"/></svg>Content Specs</h3>
      <div class="form-group">
        <label class="form-label">Topic / Description</label>
        <textarea class="form-textarea" id="topicInput" placeholder="E.g., A beginner's guide to artificial intelligence..."></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Target Audience</label>
          <input class="form-input" id="audienceInput" placeholder="e.g., Beginners, developers">
        </div>
        <div class="form-group">
          <label class="form-label">Language</label>
          <select class="form-select" id="languageInput">
            <option value="English">English</option>
            <option value="Polish">Polski</option>
            <option value="Spanish">Español</option>
            <option value="German">Deutsch</option>
            <option value="French">Français</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Tone</label>
          <select class="form-select" id="toneInput">
            <option value="">Auto</option>
            <option value="professional">Professional</option>
            <option value="conversational">Conversational</option>
            <option value="academic">Academic</option>
            <option value="creative">Creative</option>
            <option value="persuasive">Persuasive</option>
            <option value="humorous">Humorous</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Sections</label>
          <input class="form-input" id="chaptersInput" placeholder="e.g., 5" type="number" min="1" max="20">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Keywords</label>
        <input class="form-input" id="keywordsInput" placeholder="AI, machine learning, neural networks">
        <div class="form-hint">Comma-separated</div>
      </div>
    </div>

    <!-- Customize -->
    <div class="sidebar-card" id="customizeCard" style="display:none">
      <h3><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="3"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.41 1.41M11.54 11.54l1.41 1.41M3.05 12.95l1.41-1.41M11.54 4.46l1.41-1.41"/></svg>Customize Theme</h3>
      <div class="form-group">
        <label class="form-label">Accent Color</label>
        <div style="display:flex;gap:8px;align-items:center">
          <input class="form-input" id="accentColor" type="color" value="#6366F1" style="width:40px;height:36px;padding:2px;cursor:pointer;flex-shrink:0">
          <input class="form-input" id="accentColorHex" value="#6366F1" placeholder="#6366F1" style="flex:1" maxlength="7">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Background Color</label>
        <div style="display:flex;gap:8px;align-items:center">
          <input class="form-input" id="bgColor" type="color" value="#FFFFFF" style="width:40px;height:36px;padding:2px;cursor:pointer;flex-shrink:0">
          <input class="form-input" id="bgColorHex" value="#FFFFFF" placeholder="#FFFFFF" style="flex:1" maxlength="7">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Heading Font</label>
        <select class="form-select" id="headingFont">
          <option value="">Theme Default</option>
          <option value="'Georgia', serif">Georgia</option>
          <option value="'Inter', sans-serif">Inter</option>
          <option value="'Playfair Display', serif">Playfair Display</option>
          <option value="'Poppins', sans-serif">Poppins</option>
          <option value="'Merriweather', serif">Merriweather</option>
          <option value="'Lora', serif">Lora</option>
          <option value="'Palatino', serif">Palatino</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Body Font</label>
        <select class="form-select" id="bodyFont">
          <option value="">Theme Default</option>
          <option value="'Inter', sans-serif">Inter</option>
          <option value="'Georgia', serif">Georgia</option>
          <option value="'Lato', sans-serif">Lato</option>
          <option value="'Merriweather', serif">Merriweather</option>
          <option value="'Palatino', serif">Palatino</option>
        </select>
      </div>
      <div style="display:flex;gap:8px;margin-top:4px">
        <button class="btn btn-sm btn-secondary" onclick="resetCustomize()" style="flex:1">Reset</button>
      </div>
      <hr style="border:none;border-top:1px solid var(--border);margin:12px 0">
      <div class="form-group">
        <label class="form-label">AI Theme Generator</label>
        <textarea class="form-input" id="aiThemeDesc" rows="2" placeholder="Describe your theme... e.g. dark mode, neon green accents, cyberpunk vibe" style="resize:vertical;font-size:12px"></textarea>
        <button class="btn btn-sm btn-accent" onclick="generateATheme()" style="margin-top:6px;width:100%">Generate Theme</button>
        <div id="aiThemePreview" style="margin-top:6px;font-size:11px;color:var(--text-muted);display:none"></div>
      </div>
    </div>

    <!-- Custom Template Upload -->
    <div class="sidebar-card">
      <h3><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M14 4h-4l-1-2H7L6 4H2v10h12"/><path d="M8 7v6M5 10h6"/></svg>Custom Template</h3>
      <div class="form-group">
        <label class="form-label">Upload your HTML template</label>
        <input type="file" id="templateUpload" accept=".html" style="font-size:11px;width:100%">
        <button class="btn btn-sm btn-secondary" onclick="uploadCustomTemplate()" style="margin-top:4px;width:100%;font-size:10px">Upload</button>
        <div id="customTemplateList" style="margin-top:6px;font-size:11px;color:var(--text-muted)"></div>
      </div>
    </div>

    <!-- File Upload -->
    <div class="sidebar-card">
      <h3><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M8 13V3M4 7l4-4 4 4"/><path d="M2 11v2a1 1 0 001 1h10a1 1 0 001-1v-2"/></svg>Source Files</h3>
      <div class="drop-zone" id="dropZone">
        <div class="drop-zone-icon">📂</div>
        <div class="drop-zone-text">Drop files here</div>
        <div class="drop-zone-hint">Supports .txt .md .docx .pdf (multiple)</div>
        <div id="fileList" style="margin-top:8px;text-align:left"></div>
        <input type="file" id="fileInput" accept=".txt,.md,.docx,.pdf" multiple style="display:none">
      </div>
    </div>
  </aside>

  <!-- Main -->
  <main class="main">
    <!-- Content Type -->
    <div class="sidebar-card">
      <h3><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="1" y="2" width="14" height="12" rx="2"/><path d="M5 8h6M5 11h4"/></svg>Output Type</h3>
      <div class="content-tabs" id="contentTabs">
        <button class="content-tab active" data-type="ebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>Ebook</button>
        <button class="content-tab" data-type="website"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>Website</button>
        <button class="content-tab" data-type="landing-page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><path d="M9 22V12h6v10"/></svg>Landing</button>
        <button class="content-tab" data-type="blog-post"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>Blog</button>
        <button class="content-tab" data-type="interactive-book"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h12"/><circle cx="20" cy="18" r="2"/></svg>Interactive</button>
      </div>

      <!-- Templates -->
      <div id="templateSection">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
          <span style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.8px">Template</span>
          <button class="btn btn-sm btn-secondary" onclick="toggleCustomize()" id="customizeToggleBtn" style="font-size:10px">Customize</button>
        </div>
        <div class="template-grid" id="templateGrid"></div>
      </div>
    </div>

    <!-- Output Formats -->
    <div class="sidebar-card">
      <h3><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 12V4h8v8"/><path d="M8 8l-3 3h6L8 8z"/></svg>Output Formats</h3>
      <div class="format-chips" id="formatChips"></div>
    </div>

    <!-- Action Bar -->
    <div class="action-bar">
      <select class="provider-select" id="providerSelect"><option value="">Loading...</option></select>
      <button class="btn btn-primary" id="generateBtn"><span class="btn-icon">⚡</span> Generate</button>
      <button class="btn btn-secondary" id="batchBtn" style="display:none"><span class="btn-icon">📦</span> Generate All</button>
      <div style="flex:1"></div>
      <label style="font-size:11px;color:var(--text-muted);display:flex;align-items:center;gap:4px;cursor:pointer">
        <input type="checkbox" id="batchMode" onchange="toggleBatchMode()"> Batch
      </label>
      <span style="font-size:12px;color:var(--text-muted)" id="statusText"></span>
    </div>

    <!-- Progress -->
    <div class="progress-section" id="progressSection">
      <div class="sidebar-card">
        <h3><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><path d="M8 4v4l2 2"/></svg>Generation Progress</h3>
        <div class="progress-steps" id="progressSteps"></div>
        <div class="progress-bar-wrap"><div class="progress-bar-fill" id="progressFill"></div></div>
        <div class="progress-stats">
          <span class="stat" id="progressPct">0%</span>
          <span class="stat" id="progressAgent">Starting...</span>
          <span class="stat" id="progressElapsed">0s</span>
        </div>
        <button class="cancel-btn" id="cancelBtn" style="display:none;margin-top:8px;width:100%;padding:8px;border:1px solid var(--error);border-radius:var(--radius-sm);background:transparent;color:var(--error);cursor:pointer;font-size:13px">Cancel</button>
      </div>
    </div>

    <!-- Live Preview -->
    <div class="sidebar-card" id="previewCard" style="display:none">
      <h3><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M2 4h12M2 8h12M2 12h8"/></svg>Live Preview</h3>
      <div style="position:relative;border-radius:var(--radius-sm);overflow:hidden;border:1px solid var(--border);background:#fff;max-height:300px">
        <iframe id="previewFrame" style="width:100%;height:300px;border:none;background:#fff" srcdoc="<p style='padding:20px;color:#999;font-family:sans-serif'>Preview will appear when generation completes...</p>"></iframe>
      </div>
      <div style="margin-top:8px;text-align:right">
        <button class="btn btn-sm btn-secondary" onclick="document.getElementById('previewFrame').srcdoc = document.getElementById('previewFrame').srcdoc">Refresh</button>
      </div>
    </div>

    <!-- Result -->
    <div class="result-card" id="resultCard">
      <div class="result-title" id="resultTitle">✨ Your content is ready!</div>
      <div class="result-meta" id="resultMeta"></div>
      <div class="result-formats" id="resultFormats"></div>
    </div>

    <!-- Error -->
    <div class="error-card" id="errorCard">
      <div class="error-title">⚠️ Generation Failed</div>
      <div class="error-msg" id="errorMsg"></div>
      <button class="btn btn-error btn-sm" onclick="resetUI()">Try Again</button>
    </div>

    <!-- History -->
    <div class="sidebar-card" id="historyCard" style="display:none">
      <h3><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><path d="M8 4v4l2 2"/></svg>History</h3>
      <div id="historyList"></div>
    </div>

    <!-- Empty State -->
    <div class="empty-state" id="emptyState">
      <div class="empty-state-icon">🚀</div>
      <div class="empty-state-text">Configure your content specs, choose a template, and generate your publication.</div>
    </div>
  </main>
</div> <!-- /view-home -->
</div> <!-- /layout -->

<!-- View: History -->
<div class="view" id="view-history" style="display:none">
  <div class="layout">
    <aside class="sidebar" style="max-width:100%;flex:1">
      <div class="sidebar-card">
        <h3><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><path d="M8 4v4l2 2"/></svg>History</h3>
        <div id="historyListFull"></div>
      </div>
      <button class="btn btn-sm btn-secondary" onclick="clearHistory()" style="width:100%">Clear History</button>
    </aside>
  </div>
</div>

<!-- View: Admin -->
