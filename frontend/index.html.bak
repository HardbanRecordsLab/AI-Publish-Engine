        </div>
        <button class="btn btn-primary" onclick="generateMarketing()" style="width:100%">Generate Marketing Materials</button>
      </div>
      <div id="marketingResults"></div>
    </aside>
  </div>
</div>

<div class="view" id="view-coach" style="display:none">
