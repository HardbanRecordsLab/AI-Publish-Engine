        <h3>📤 Direct Publishing</h3>
        <div class="form-group">
          <label class="form-label">Job ID</label>
          <input class="form-input" id="publishJobId" placeholder="Job ID">
        </div>
        <button class="btn btn-primary" onclick="loadPublishInfo()" style="width:100%;margin-bottom:12px">Load Publishing Info</button>
        <div id="publishResults"></div>
